<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
        x:Class="Nimbie_Rename_UI.MainWindow"
        Title="Nimbie Process"
        Icon="/Assets/cd.ico">

	<Grid Margin="15" RowDefinitions="Auto,*">
		
		<TabControl Grid.Row="1">

			<!-- Existing Nimbie Process tab -->
			<TabItem Header="Rename Nimbie Files">

				<Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                      Margin="5"
                      RowSpacing="12">

					<!-- Paths -->
					<Border Grid.Row="2"
                            Padding="10"
                            CornerRadius="8"
                            Background="#E8E8E8">

						<StackPanel Spacing="10">

							<TextBlock  Text="Nimbie Output Directory"
                                        Foreground="#222222"/>

							<Grid ColumnDefinitions="Auto,*">
								<Button Content="Browse"
                                        Click="PickImageFolder"
                                        Background="#CCCCCC"
                                        Grid.Column="0"/>

								<TextBox Name="ImagePathBox"
                                         Margin="6,0,0,0"
                                         HorizontalAlignment="Stretch"
                                         Grid.Column="1"
                                         Background="#FFFFFF"/>
							</Grid>
						</StackPanel>
					</Border>

					<!-- Actions -->
					<StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Spacing="10">

						<Button Padding="15,8"
                                Name="RunButton"
                                Content="Rename Files"
                                Click="RenameFiles"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

						<Button Padding="15,8"
                                Content="Exit"
                                Click="ExitApp"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

					</StackPanel>

					<!-- Output -->
					<Border Grid.Row="5"
                            Padding="8"
                            CornerRadius="8"
                            Background="#E8E8E8">

						<TextBox Name="OutputBox"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
								 TextWrapping="Wrap"
                                 FontFamily="avares://Nimbie_Rename_UI/Assets/Fonts#JetBrains Mono, Consolas, monospace"
                                 Background="#FFFFFF"/>

					</Border>

				</Grid>

			</TabItem>

			<!-- Rename tab -->
			<TabItem Header="Update Medialog">
				<Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                      Margin="5"
                      RowSpacing="12">

					<!-- Paths -->
					<Border Grid.Row="1"
                            Padding="10"
                            CornerRadius="8"
                            Background="#E8E8E8">

						<StackPanel Spacing="10">

							<TextBlock Text="Nimbie Output Directory"
                                       Foreground="#222222"/>

							<Grid ColumnDefinitions="Auto,*">
								<Button Content="Browse"
                                        Click="PickRenameFolder"
                                        Background="#CCCCCC"
                                        Grid.Column="0"/>

								<TextBox Name="RenamePathBox"
                                         Margin="6,0,0,0"
                                         HorizontalAlignment="Stretch"
                                         Grid.Column="1"
                                         Background="#FFFFFF"/>
							</Grid>

							<Grid ColumnDefinitions="3*,*"
                                  RowDefinitions="Auto,Auto">

								<TextBlock Text="Nimbie User"
                                           Foreground="#222222"
                                           Grid.Column="0"
                                           Grid.Row="0"/>

								<TextBlock Text="Box Number"
                                           Foreground="#222222"
                                           Grid.Column="1"
                                           Grid.Row="0"/>

								<TextBox Name="NimbieUserBox"
                                         Margin="0,4,6,0"
                                         Grid.Column="0"
                                         Grid.Row="1"
										 Background="#FFFFFF"/>

								<TextBox Name="NimbieBoxNum"
                                         Margin="6,4,0,0"
                                         Grid.Column="1"
                                         Grid.Row="1"
										 Background="#FFFFFF"/>

							</Grid>
						</StackPanel>
					</Border>
					<StackPanel Grid.Row="2"
			                    Orientation="Horizontal"
			                    Spacing="10">


						<Button Padding="15,8"
                                Name="UpdateButton"
                                Content="Update Medialog"
                                Click="UpdateMedialog"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

						<Button Padding="15,8"
                                Content="Exit"
                                Click="ExitApp"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

					</StackPanel>
					<!-- Output -->
					<Border Grid.Row="4"
                            Padding="8"
                            CornerRadius="8"
                            Background="#E8E8E8">

						<TextBox Name="UpdateOutputBox"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 FontFamily="avares://Nimbie_Rename_UI/Assets/Fonts#JetBrains Mono, Consolas, monospace"
                                 Background="#FFFFFF"/>

					</Border>
					
				</Grid>
				
			</TabItem>

		</TabControl>

	</Grid>

</Window>
